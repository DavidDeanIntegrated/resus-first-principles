---
import Base from '../../layouts/Base.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import Contents from '../../components/Contents.astro';
import ListenButton from '../../components/ListenButton.astro';
import ManagementOverview from '../../components/ManagementOverview.astro';
import ReferenceList from '../../components/ReferenceList.astro';
import SectionPart from '../../components/SectionPart.astro';
import TreatmentStep from '../../components/TreatmentStep.astro';
import { hasNarration, narrationFor } from '../../lib/narration.ts';
import { loadCases } from '../../lib/cases.ts';
import { marksFor, referenceNumbers } from '../../lib/references.ts';
import { sectionNumerals } from '../../lib/roman.ts';
import { sectionTree } from '../../lib/sections.ts';

export async function getStaticPaths() {
  const cases = await loadCases();
  return cases.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const numbers = referenceNumbers(entry.data.references);
const numbered = sectionNumerals(entry.data.principles);
const numerals = new Map([...numbered].map(([id, value]) => [id, value.label]));
const principleMeta = new Map(
  entry.data.principles.map((principle) => [
    principle.id,
    {
      numeral: numerals.get(principle.id) ?? principle.id,
      title: principle.title,
      href: `#principle-${principle.id}`,
    },
  ]),
);
const description = entry.data.shareDescription ?? entry.data.summary;
const causeNames: Record<string, string> = {};
for (const principle of entry.data.principles) {
  for (const cause of principle.causes ?? []) causeNames[cause.id] = cause.name;
}
const parts = sectionTree(entry.data.principles);
const numeralRecord = Object.fromEntries(numerals);
---

<Base
  title={entry.data.title}
  description={description}
  ogType="article"
  audio={hasNarration(entry.data.slug)}
>
  <div class="wrap">
    <Contents sections={entry.data.principles} />
    <div class="case-body">
      <section class="hero">
        <p class="kicker">Case</p>
        <h1>{entry.data.title}</h1>
        {
          entry.data.reviewNote && (
            <p class="review-note">
              <span class="field-label">Review</span>
              {entry.data.reviewNote}
            </p>
          )
        }
        {
          entry.data.contentStatus === 'placeholder' && (
            <p class="notice" role="status">
              PLACEHOLDER FIXTURE. This page is not clinical content and is not for patient care.
            </p>
          )
        }
        <p class="lede">{entry.data.summary}</p>
      </section>

      {
        entry.data.contentStatus === 'placeholder' && (
          <aside class="side">
            PLACEHOLDER margin note. Desktop only. This aside is not essential and is not clinical content.
          </aside>
        )
      }

      {
        parts.map((part) => {
          return (
            <SectionPart
              principle={part.item}
              subsections={part.children.map((child) => child.item)}
              numeral={numerals.get(part.item.id) ?? ''}
              numerals={numeralRecord}
              partNumber={numbered.get(part.item.id)?.partNumber ?? 0}
              causeNames={causeNames}
              referenceNumbers={numbers}
            />
          );
        })
      }
    </div>
  </div>

  <section class="treat" aria-labelledby="treatment-heading">
    <div class="wrap">
      <div class="treat-inner">
        <p class="kicker">Putting it together</p>
        <h2 id="treatment-heading">Approach to treatment</h2>
        {
          narrationFor(entry.data.slug)?.tracks.some((track) => track.anchor === 'treatment-heading') && (
            <ListenButton anchor="treatment-heading" title="Approach to treatment" />
          )
        }
        <ManagementOverview steps={entry.data.treatmentApproach} />
        <ol class="steps">
          {
            entry.data.treatmentApproach.map((step, index) => (
              <TreatmentStep
                id={step.id}
                number={index + 1}
                title={step.title}
                action={step.action}
                why={step.why}
                marks={marksFor(step.refs, numbers)}
                principles={step.principleIds.map((principleId) => {
                  const meta = principleMeta.get(principleId);
                  return {
                    href: meta?.href ?? `#principle-${principleId}`,
                    numeral: meta?.numeral ?? principleId,
                    title: meta?.title ?? principleId,
                  };
                })}
              />
            ))
          }
        </ol>
      </div>
    </div>
  </section>
  {entry.data.references && <ReferenceList references={entry.data.references} />}
  {
    hasNarration(entry.data.slug) && (
      <AudioPlayer slug={entry.data.slug} />
    )
  }
</Base>
