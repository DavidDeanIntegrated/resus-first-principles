---
import Base from '../../layouts/Base.astro';
import CauseList from '../../components/CauseList.astro';
import PrincipleDiagram from '../../components/PrincipleDiagram.astro';
import PrincipleHeader from '../../components/PrincipleHeader.astro';
import QuestionCard from '../../components/QuestionCard.astro';
import ReferenceList from '../../components/ReferenceList.astro';
import TreatmentStep from '../../components/TreatmentStep.astro';
import { loadCases } from '../../lib/cases.ts';
import { asParagraphs, splitLead } from '../../lib/prose.ts';
import { marksFor, referenceNumbers } from '../../lib/references.ts';
import { toRoman } from '../../lib/roman.ts';

export async function getStaticPaths() {
  const cases = await loadCases();
  return cases.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const numbers = referenceNumbers(entry.data.references);
const principleMeta = new Map(
  entry.data.principles.map((principle, index) => [
    principle.id,
    { numeral: toRoman(index + 1), title: principle.title, href: `#principle-${principle.id}` },
  ]),
);
const description = entry.data.summary;
const causeNames: Record<string, string> = {};
for (const principle of entry.data.principles) {
  for (const cause of principle.causes ?? []) causeNames[cause.id] = cause.name;
}
---

<Base title={entry.data.title} description={description}>
  <div class="wrap">
    <section class="hero">
      <p class="kicker">Case</p>
      <h1>{entry.data.title}</h1>
      {entry.data.reviewNote && <p class="notice">{entry.data.reviewNote}</p>}
      {
        entry.data.contentStatus === 'placeholder' && (
          <p class="notice" role="status">
            PLACEHOLDER FIXTURE. This page is not clinical content and is not for patient care.
          </p>
        )
      }
      <p class="lede">{entry.data.summary}</p>
      <ol class="toc">
        {
          entry.data.principles.map((principle) => (
            <li>
              <a href={`#principle-${principle.id}`}>{principle.title}</a>
            </li>
          ))
        }
      </ol>
    </section>

    {
      entry.data.contentStatus === 'placeholder' && (
        <aside class="side">
          PLACEHOLDER margin note. Desktop only. This aside is not essential and is not clinical content.
        </aside>
      )
    }

    {
      entry.data.principles.map((principle, principleIndex) => {
        const paragraphs = asParagraphs(principle.explanation);
        const { lead, rest } = splitLead(paragraphs[0] ?? '');
        const body = [rest, ...paragraphs.slice(1)].filter((paragraph) => paragraph.length > 0);
        return (
        <PrincipleHeader
          id={`principle-${principle.id}`}
          numeral={toRoman(principleIndex + 1)}
          title={principle.title}
          summary={lead}
          marks={marksFor(principle.refs, numbers)}
        >
          {body.length > 0 && (
            <div class="prose">
              {body.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          )}
          {principle.diagram && <PrincipleDiagram diagram={principle.diagram} />}
          {principle.causes && principle.causes.length > 0 && (
            <CauseList causes={principle.causes} causeNames={causeNames} referenceNumbers={numbers} />
          )}
          {principle.questions.map((question, questionIndex) => {
            const meta = principleMeta.get(principle.id);
            return (
              <QuestionCard
                id={question.id}
                label={`Question ${principleIndex + 1}.${questionIndex + 1}`}
                kind={question.kind}
                prompt={question.prompt}
                answer={question.answer}
                reasoning={question.reasoning}
                conclusion={question.conclusion}
                causalChain={question.causalChain}
                assumption={question.assumption}
                misconception={question.misconception}
                missingData={question.missingData}
                marks={marksFor(question.refs, numbers)}
                buildsOnHref={meta?.href ?? `#principle-${principle.id}`}
                buildsOnNumeral={meta?.numeral ?? toRoman(principleIndex + 1)}
                buildsOnTitle={meta?.title ?? principle.title}
              />
            );
          })}
        </PrincipleHeader>
        );
      })
    }
  </div>

  <section class="treat" aria-labelledby="treatment-heading">
    <div class="wrap">
      <div class="treat-inner">
        <p class="kicker">Putting it together</p>
        <h2 id="treatment-heading">Approach to treatment</h2>
        <ol class="steps">
          {
            entry.data.treatmentApproach.map((step, index) => (
              <TreatmentStep
                id={step.id}
                number={index + 1}
                title={step.title}
                action={step.action}
                why={step.why}
                marks={marksFor(step.refs, numbers)}
                principles={step.principleIds.map((principleId) => {
                  const meta = principleMeta.get(principleId);
                  return {
                    href: meta?.href ?? `#principle-${principleId}`,
                    numeral: meta?.numeral ?? principleId,
                    title: meta?.title ?? principleId,
                  };
                })}
              />
            ))
          }
        </ol>
      </div>
    </div>
  </section>
  {entry.data.references && <ReferenceList references={entry.data.references} />}
</Base>
