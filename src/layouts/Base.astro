---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Home is a website. A case is an article. */
  ogType?: 'website' | 'article';
  /** Adult cardiac arrest opts in so narration controls can show. */
  audio?: boolean;
  /** Draft chapters are noindex wherever they render. */
  noindex?: boolean;
}

const { title, description, ogType = 'website', audio = false, noindex = false } = Astro.props;

const SITE_NAME = 'Resus First Principles';
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;

const site = Astro.site;
if (!site) {
  throw new Error('Set site in astro.config.mjs to the canonical origin.');
}

/**
 * Directory pages are served with a trailing slash. Status pages are flat files
 * (`404.html`), which this host serves without one.
 */
const STATUS_PAGES = new Set(['/404', '/500', '/3xx']);
function canonicalPath(pathname: string): string {
  const bare = pathname.length > 1 && pathname.endsWith('/') ? pathname.slice(0, -1) : pathname;
  if (STATUS_PAGES.has(bare)) return bare;
  return pathname.endsWith('/') ? pathname : `${pathname}/`;
}
const canonical = new URL(canonicalPath(Astro.url.pathname), site).href;
const imageUrl = new URL('/og-image.png', site).href;
const imageAlt = 'Resus First Principles logo mark and title.';

const themeBoot = `(function () {
  var theme = "system";
  try {
    var stored = localStorage.getItem("rfp-theme");
    if (stored === "light" || stored === "dark" || stored === "system") theme = stored;
  } catch (error) {
    theme = "system";
  }
  document.documentElement.setAttribute("data-theme", theme);
})();`;

const themeChoice = `(function () {
  var root = document.documentElement;
  var theme = root.getAttribute("data-theme") || "system";
  var inputs = document.querySelectorAll('input[name="color-theme"]');
  function apply(next) {
    if (next !== "light" && next !== "dark" && next !== "system") return;
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("rfp-theme", next);
    } catch (error) {
      /* Preference stays on the element for this view. */
    }
  }
  for (var i = 0; i < inputs.length; i++) {
    var input = inputs[i];
    if (input.value === theme) input.checked = true;
    input.addEventListener("change", function (event) {
      var target = event.target;
      apply(target && target.value);
    });
  }
})();`;

const themeBootTag = `<script>${themeBoot}</script>`;
const themeChoiceTag = `<script>${themeChoice}</script>`;
---

<!doctype html>
<html lang="en" data-audio={audio ? 'available' : undefined}>
  <head>
    <Fragment set:html={themeBootTag} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbf6ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1915" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/Fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Literata-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/">Resus <em>First Principles</em></a>
      <div class="site-tools">
        <nav class="site-nav" aria-label="Site">
          <a href="/">Cases</a>
        </nav>
        <fieldset class="theme-toggle">
          <legend class="sr-only">Color theme</legend>
          <label>
            <input type="radio" name="color-theme" value="light" />
            <span>Light</span>
          </label>
          <label>
            <input type="radio" name="color-theme" value="dark" />
            <span>Dark</span>
          </label>
          <label>
            <input type="radio" name="color-theme" value="system" checked />
            <span>System</span>
          </label>
        </fieldset>
        <Fragment set:html={themeChoiceTag} />
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Static study pages rendered from files committed in this repository. No accounts, backend, or
        analytics. They are not a clinical protocol and do not replace current resuscitation
        guidelines or clinical judgment.
      </p>
    </footer>
  </body>
</html>
