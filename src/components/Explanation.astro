---
interface Props {
  buildsOnHref: string;
  buildsOnNumeral: string;
  buildsOnTitle: string;
}

const { buildsOnHref, buildsOnNumeral, buildsOnTitle } = Astro.props;
const hasBody = Astro.slots.has('default');
---

<div class="why">
  {hasBody && <h3>The reasoning</h3>}
  <slot />
  <p class="back">
    Builds on <a href={buildsOnHref}>{buildsOnNumeral} · {buildsOnTitle}</a>
  </p>
</div>
