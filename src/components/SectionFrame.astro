---
import CauseList from './CauseList.astro';
import MarkdownParagraphs from './MarkdownParagraphs.astro';
import PrincipleDiagram from './PrincipleDiagram.astro';
import PrincipleHeader from './PrincipleHeader.astro';
import ProseParagraphs from './ProseParagraphs.astro';
import { figuresForPrinciple, groupParagraphs, inlineFiguresAfter, primerAnchorErrors } from '../lib/figure-placement.ts';
import { physiologyAnchorErrors } from '../lib/physiology-figures.ts';
import { stripInlineMarkdown } from '../lib/markdown.ts';
import { asParagraphs, splitLead } from '../lib/prose.ts';
import { subheadBefore } from '../lib/section-layout.ts';
import type { ReferenceMark } from '../lib/references.ts';
import type { Principle } from '../lib/schema.ts';

interface Props {
  principle: Principle;
  numeral: string;
  marks?: readonly ReferenceMark[];
  causeNames: Readonly<Record<string, string>>;
  referenceNumbers: ReadonlyMap<string, number>;
}

const { principle, numeral, marks, causeNames, referenceNumbers } = Astro.props;
const explanation = principle.explanation ? asParagraphs(principle.explanation) : [];
const narrative = principle.body ?? [];
let lead = '';
let explanationLeadRest = '';
let markdownLeadRest = '';

if (explanation.length > 0) {
  const split = splitLead(explanation[0] ?? '');
  lead = stripInlineMarkdown(split.lead);
  explanationLeadRest = split.rest;
} else if (narrative.length > 0) {
  const split = splitLead(narrative[0] ?? '');
  lead = stripInlineMarkdown(split.lead);
  markdownLeadRest = split.rest;
}

const anchorErrors = [
  ...physiologyAnchorErrors(principle.id, [...explanation, ...narrative]),
  ...primerAnchorErrors(principle.id, [...explanation, ...narrative]),
];
if (anchorErrors.length > 0) throw new Error(anchorErrors.join('; '));

const explanationGroups = groupParagraphs(
  explanation,
  (paragraph, index) => (index === 0 ? explanationLeadRest : paragraph),
  (paragraph) => inlineFiguresAfter(principle.id, paragraph),
);
const markdownGroups = groupParagraphs(
  narrative,
  (paragraph, index) => (explanation.length > 0 ? paragraph : index === 0 ? markdownLeadRest : paragraph),
  (paragraph) => inlineFiguresAfter(principle.id, paragraph),
);
const inlineFigureIds = new Set<string>([
  ...explanationGroups.flatMap((group) => group.figures),
  ...markdownGroups.flatMap((group) => group.figures),
]);
const leadSubhead = subheadBefore(principle.id, explanation[0] ?? narrative[0] ?? '');
---

<PrincipleHeader
  id={`principle-${principle.id}`}
  numeral={numeral}
  title={principle.title}
  summary={lead}
  subhead={leadSubhead}
  marks={marks}
>
  {
    explanationGroups.map((group) => (
      <>
        {group.paragraphs.length > 0 && (
          <div class="prose">
            <ProseParagraphs principleId={principle.id} paragraphs={group.paragraphs} />
          </div>
        )}
        {group.figures.map((diagram) => (
          <PrincipleDiagram diagram={diagram} causeNames={causeNames} />
        ))}
      </>
    ))
  }
  {
    markdownGroups.map((group) => (
      <>
        {group.paragraphs.length > 0 && (
          <div class="prose">
            <ProseParagraphs principleId={principle.id} paragraphs={group.paragraphs} />
          </div>
        )}
        {group.figures.map((diagram) => (
          <PrincipleDiagram diagram={diagram} causeNames={causeNames} />
        ))}
      </>
    ))
  }
  {
    principle.workedExample && (
      <aside class="worked-example" id={`worked-example-${principle.workedExample.id}`}>
        <h3>{principle.workedExample.title}</h3>
        <div class="prose">
          <MarkdownParagraphs paragraphs={principle.workedExample.body} />
        </div>
      </aside>
    )
  }
  {
    principle.diagram && !inlineFigureIds.has(principle.diagram) && (
      <PrincipleDiagram diagram={principle.diagram} causeNames={causeNames} />
    )
  }
  {
    figuresForPrinciple(principle.id).map((diagram) => (
      <PrincipleDiagram diagram={diagram} causeNames={causeNames} />
    ))
  }
  {
    principle.causes && principle.causes.length > 0 && (
      <CauseList causes={principle.causes} causeNames={causeNames} referenceNumbers={referenceNumbers} />
    )
  }
  <slot />
</PrincipleHeader>
