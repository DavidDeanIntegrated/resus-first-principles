---
import CompressionPause from './diagrams/CompressionPause.astro';
import CoronaryCircuit from './diagrams/CoronaryCircuit.astro';
import PhysiologyFigure from './diagrams/PhysiologyFigure.astro';
import PressureGradient from './diagrams/PressureGradient.astro';
import ReversibleCauseOverlap from './diagrams/ReversibleCauseOverlap.astro';
import { isPhysiologyFigureId } from '../lib/physiology-figures.ts';
import type { PlacedFigureId } from '../lib/figure-placement.ts';
import type { DiagramId } from '../lib/schema.ts';

interface Props {
  diagram: DiagramId | PlacedFigureId;
  causeNames?: Readonly<Record<string, string>>;
}

const diagrams = {
  'pressure-gradient': PressureGradient,
  'compression-pause': CompressionPause,
} satisfies Record<DiagramId, typeof PressureGradient>;

const { diagram, causeNames = {} } = Astro.props;
const Diagram = diagram === 'pressure-gradient' || diagram === 'compression-pause' ? diagrams[diagram] : null;
---

{
  diagram === 'coronary-circuit' ? (
    <CoronaryCircuit />
  ) : isPhysiologyFigureId(diagram) ? (
    <PhysiologyFigure id={diagram} />
  ) : diagram === 'reversible-cause-overlap' ? (
    <ReversibleCauseOverlap causeNames={causeNames} />
  ) : (
    Diagram && <Diagram />
  )
}
