---
import CompressionPause from './diagrams/CompressionPause.astro';
import CompressionRelease from './diagrams/CompressionRelease.astro';
import CoronaryCircuit from './diagrams/CoronaryCircuit.astro';
import PhysiologyFigure from './diagrams/PhysiologyFigure.astro';
import PressureGradient from './diagrams/PressureGradient.astro';
import PressurePairs from './diagrams/PressurePairs.astro';
import ReversibleCauseOverlap from './diagrams/ReversibleCauseOverlap.astro';
import SepticFigure from './diagrams/SepticFigure.astro';
import ShockCirculationGradients from './diagrams/ShockCirculationGradients.astro';
import ShockFluidResponse from './diagrams/ShockFluidResponse.astro';
import ShockPressureFlow from './diagrams/ShockPressureFlow.astro';
import { isPhysiologyFigureId } from '../lib/physiology-figures.ts';
import { isSepticFigureId } from '../lib/septic-figures.ts';
import type { PlacedFigureId } from '../lib/figure-placement.ts';
import type { DiagramEntry, DiagramField, DiagramId } from '../lib/schema.ts';

interface Props {
  diagram: DiagramId | DiagramField | PlacedFigureId | DiagramEntry;
  causeNames?: Readonly<Record<string, string>>;
}

const diagrams = {
  'pressure-gradient': PressureGradient,
  'compression-pause': CompressionPause,
  'shock-circulation-gradients': ShockCirculationGradients,
  'shock-pressure-flow': ShockPressureFlow,
  'shock-fluid-response': ShockFluidResponse,
} satisfies Record<DiagramId, unknown>;

const shockDiagrams = {
  'shock-circulation-gradients': ShockCirculationGradients,
  'shock-pressure-flow': ShockPressureFlow,
  'shock-fluid-response': ShockFluidResponse,
} as const;

const { diagram, causeNames = {} } = Astro.props;
const diagramId = typeof diagram === 'string' ? diagram : diagram.id;
const caption = typeof diagram === 'string' ? '' : diagram.caption;
const alt = typeof diagram === 'string' ? '' : diagram.alt;

function isShockDiagramId(id: string): id is keyof typeof shockDiagrams {
  return Object.hasOwn(shockDiagrams, id);
}

const Diagram = diagramId === 'pressure-gradient' || diagramId === 'compression-pause' ? diagrams[diagramId] : null;
const Shock = isShockDiagramId(diagramId) ? shockDiagrams[diagramId] : null;
---

{
  diagramId === 'coronary-circuit' ? (
    <CoronaryCircuit />
  ) : diagramId === 'pressure-pairs' ? (
    <PressurePairs />
  ) : diagramId === 'compression-release' ? (
    <CompressionRelease />
  ) : isPhysiologyFigureId(diagramId) ? (
    <PhysiologyFigure id={diagramId} />
  ) : diagramId === 'reversible-cause-overlap' ? (
    <ReversibleCauseOverlap causeNames={causeNames} />
  ) : Shock ? (
    <Shock caption={caption} alt={alt} />
  ) : isSepticFigureId(diagramId) ? (
    <SepticFigure id={diagramId} caption={caption} alt={alt} />
  ) : (
    Diagram && <Diagram />
  )
}
