---
interface Props {
  id: string;
  title: string;
  desc: string;
  caption: string;
}

const { id, title, desc, caption } = Astro.props;
const screenTitleId = `${id}-screen-title`;
const screenDescId = `${id}-screen-desc`;
const printTitleId = `${id}-print-title`;
const printDescId = `${id}-print-desc`;
const screenMarkerId = `${id}-screen-ah`;
const printMarkerId = `${id}-print-ah`;
---

<figure class="diagram" data-diagram={id}>
  <svg
    class="diagram-screen"
    viewBox="0 0 320 140"
    role="img"
    aria-labelledby={screenTitleId}
    aria-describedby={screenDescId}
  >
    <title id={screenTitleId}>{title}</title>
    <desc id={screenDescId}>{desc}</desc>
    <defs>
      <marker
        id={screenMarkerId}
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="8"
        markerHeight="8"
        orient="auto-start-reverse"
      >
        <path class="diagram-route-head" d="M0 0 L10 5 L0 10 Z"></path>
      </marker>
    </defs>
    <rect class="diagram-node" x="16" y="16" width="288" height="108" rx="6"></rect>
    <text class="diagram-kicker" x="32" y="58" font-size="14">Figure in progress</text>
    <line
      class="diagram-route"
      x1="32"
      y1="92"
      x2="148"
      y2="92"
      marker-end={`url(#${screenMarkerId})`}></line>
  </svg>
  <svg
    class="diagram-print"
    viewBox="0 0 664 140"
    role="img"
    aria-labelledby={printTitleId}
    aria-describedby={printDescId}
  >
    <title id={printTitleId}>{title}</title>
    <desc id={printDescId}>{desc}</desc>
    <defs>
      <marker
        id={printMarkerId}
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="8"
        markerHeight="8"
        orient="auto-start-reverse"
      >
        <path class="diagram-route-head" d="M0 0 L10 5 L0 10 Z"></path>
      </marker>
    </defs>
    <rect class="diagram-node" x="16" y="16" width="632" height="108" rx="6"></rect>
    <text class="diagram-kicker" x="32" y="58" font-size="15">Figure in progress</text>
    <line
      class="diagram-route"
      x1="32"
      y1="92"
      x2="180"
      y2="92"
      marker-end={`url(#${printMarkerId})`}></line>
  </svg>
  <figcaption>
    <p class="kicker">Figure</p>
    <p>{caption}</p>
  </figcaption>
</figure>
