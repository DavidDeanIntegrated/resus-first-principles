---
// S5 (Atelier): drawn figure; replaces the S6 placeholder. Caption comes from the module (prop);
// title and desc are copied verbatim from s4/manuscript.md (sha 6c0f5c0a). Schematic; tokens only.
interface Props {
  caption: string;
  alt: string;
}

const { caption } = Astro.props;
const title = "Similar pressure, different flow.";
const desc = "Two side-by-side tubes, each labeled with the same pressure difference of 55 millimeters of mercury from inlet to outlet. The left tube is wider, labeled resistance 11 mm Hg·min per liter, with a thick arrow labeled flow 5 liters per minute. The right tube is narrower, labeled resistance 22 mm Hg·min per liter, with a thin arrow labeled flow 2.5 liters per minute. Below each, the equation 55 = 5 × 11 and 55 = 2.5 × 22. Values are marked illustrative.";
---

<figure class="diagram" data-diagram="shock-pressure-flow">
  <svg class="diagram-screen" viewBox="0 0 320 574" role="img" aria-labelledby="shock-pressure-flow-screen-title" aria-describedby="shock-pressure-flow-screen-desc"><title id="shock-pressure-flow-screen-title">{title}</title><desc id="shock-pressure-flow-screen-desc">{desc}</desc><defs><marker id="shock-pressure-flow-screen-ah" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto-start-reverse"><path class="diagram-flow-head" d="M0,0 L10,5 L0,10 z"/></marker></defs><text class="diagram-kicker" x="16" y="28" font-size="14">Left system</text><text class="diagram-label" x="84" y="62" font-size="15" text-anchor="middle">Inlet pressure</text><line class="diagram-vessel-open" x1="54" y1="78" x2="54" y2="232"/><line class="diagram-vessel-open" x1="114" y1="78" x2="114" y2="232"/><line class="diagram-flow diagram-flow-thick" x1="84" y1="90" x2="84" y2="218" marker-end="url(#shock-pressure-flow-screen-ah)"/><text class="diagram-label" x="84" y="256" font-size="15" text-anchor="middle">Outlet pressure</text><text class="diagram-label" x="84" y="296" font-size="15" text-anchor="middle">Pressure difference</text><text class="diagram-display" x="84" y="320" font-size="17" text-anchor="middle">55 mm Hg</text><text class="diagram-label" x="84" y="356" font-size="15" text-anchor="middle">Resistance</text><text class="diagram-display" x="84" y="380" font-size="17" text-anchor="middle">11 mm Hg·min/L</text><text class="diagram-label" x="84" y="416" font-size="15" text-anchor="middle">Flow</text><text class="diagram-display" x="84" y="440" font-size="17" text-anchor="middle">5 L/min</text><rect class="diagram-eq" x="16" y="462" width="136" height="44" rx="3"/><text class="diagram-display" x="84" y="490" font-size="17" text-anchor="middle">55 = 5 × 11</text><text class="diagram-kicker" x="168" y="28" font-size="14">Right system</text><text class="diagram-label" x="236" y="62" font-size="15" text-anchor="middle">Inlet pressure</text><line class="diagram-vessel-open" x1="221" y1="78" x2="221" y2="232"/><line class="diagram-vessel-open" x1="251" y1="78" x2="251" y2="232"/><line class="diagram-flow diagram-flow-thin" x1="236" y1="90" x2="236" y2="218" marker-end="url(#shock-pressure-flow-screen-ah)"/><text class="diagram-label" x="236" y="256" font-size="15" text-anchor="middle">Outlet pressure</text><text class="diagram-label" x="236" y="296" font-size="15" text-anchor="middle">Pressure difference</text><text class="diagram-display" x="236" y="320" font-size="17" text-anchor="middle">55 mm Hg</text><text class="diagram-label" x="236" y="356" font-size="15" text-anchor="middle">Resistance</text><text class="diagram-display" x="236" y="380" font-size="17" text-anchor="middle">22 mm Hg·min/L</text><text class="diagram-label" x="236" y="416" font-size="15" text-anchor="middle">Flow</text><text class="diagram-display" x="236" y="440" font-size="17" text-anchor="middle">2.5 L/min</text><rect class="diagram-eq" x="168" y="462" width="136" height="44" rx="3"/><text class="diagram-display" x="236" y="490" font-size="17" text-anchor="middle">55 = 2.5 × 22</text><text class="diagram-note" x="16" y="530" font-size="15">In each, gradient = flow × resistance.</text><text class="diagram-caps" x="16" y="556" font-size="12">ILLUSTRATIVE VALUES, NOT PATIENT TARGETS</text></svg>
  <svg class="diagram-print" viewBox="0 0 664 592" role="img" aria-labelledby="shock-pressure-flow-print-title" aria-describedby="shock-pressure-flow-print-desc"><title id="shock-pressure-flow-print-title">{title}</title><desc id="shock-pressure-flow-print-desc">{desc}</desc><defs><marker id="shock-pressure-flow-print-ah" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto-start-reverse"><path class="diagram-flow-head" d="M0,0 L10,5 L0,10 z"/></marker></defs><text class="diagram-kicker" x="16" y="28" font-size="14">Left system</text><text class="diagram-label" x="166" y="62" font-size="15" text-anchor="middle">Inlet pressure</text><line class="diagram-vessel-open" x1="124" y1="78" x2="124" y2="250"/><line class="diagram-vessel-open" x1="208" y1="78" x2="208" y2="250"/><line class="diagram-flow diagram-flow-thick" x1="166" y1="90" x2="166" y2="236" marker-end="url(#shock-pressure-flow-print-ah)"/><text class="diagram-label" x="166" y="274" font-size="15" text-anchor="middle">Outlet pressure</text><text class="diagram-label" x="166" y="314" font-size="15" text-anchor="middle">Pressure difference</text><text class="diagram-display" x="166" y="338" font-size="18" text-anchor="middle">55 mm Hg</text><text class="diagram-label" x="166" y="374" font-size="15" text-anchor="middle">Resistance</text><text class="diagram-display" x="166" y="398" font-size="18" text-anchor="middle">11 mm Hg·min/L</text><text class="diagram-label" x="166" y="434" font-size="15" text-anchor="middle">Flow</text><text class="diagram-display" x="166" y="458" font-size="18" text-anchor="middle">5 L/min</text><rect class="diagram-eq" x="16" y="480" width="300" height="44" rx="3"/><text class="diagram-display" x="166" y="508" font-size="18" text-anchor="middle">55 = 5 × 11</text><text class="diagram-kicker" x="348" y="28" font-size="14">Right system</text><text class="diagram-label" x="498" y="62" font-size="15" text-anchor="middle">Inlet pressure</text><line class="diagram-vessel-open" x1="477" y1="78" x2="477" y2="250"/><line class="diagram-vessel-open" x1="519" y1="78" x2="519" y2="250"/><line class="diagram-flow diagram-flow-thin" x1="498" y1="90" x2="498" y2="236" marker-end="url(#shock-pressure-flow-print-ah)"/><text class="diagram-label" x="498" y="274" font-size="15" text-anchor="middle">Outlet pressure</text><text class="diagram-label" x="498" y="314" font-size="15" text-anchor="middle">Pressure difference</text><text class="diagram-display" x="498" y="338" font-size="18" text-anchor="middle">55 mm Hg</text><text class="diagram-label" x="498" y="374" font-size="15" text-anchor="middle">Resistance</text><text class="diagram-display" x="498" y="398" font-size="18" text-anchor="middle">22 mm Hg·min/L</text><text class="diagram-label" x="498" y="434" font-size="15" text-anchor="middle">Flow</text><text class="diagram-display" x="498" y="458" font-size="18" text-anchor="middle">2.5 L/min</text><rect class="diagram-eq" x="348" y="480" width="300" height="44" rx="3"/><text class="diagram-display" x="498" y="508" font-size="18" text-anchor="middle">55 = 2.5 × 22</text><text class="diagram-note" x="16" y="548" font-size="15">In each, gradient = flow × resistance.</text><text class="diagram-caps" x="16" y="574" font-size="12">ILLUSTRATIVE VALUES, NOT PATIENT TARGETS</text></svg>
  <figcaption>
    <p class="kicker">Figure</p>
    <p>{caption}</p>
  </figcaption>
</figure>
