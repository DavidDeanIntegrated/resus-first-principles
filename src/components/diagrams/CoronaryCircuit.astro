---
const wideTitleId = 'diagram-coronary-circuit-wide-title';
const wideDescId = 'diagram-coronary-circuit-wide-desc';
const stackTitleId = 'diagram-coronary-circuit-stack-title';
const stackDescId = 'diagram-coronary-circuit-stack-desc';

const title = 'The coronary circuit, from the aortic root across the heart muscle to the right atrium.';
const description =
  'Schematic route from the aortic root through the coronary arteries, small vessels and capillaries within the heart muscle, then cardiac veins and coronary sinus into the right atrium. Marker 1 at the aortic root shows aortic pressure here. Marker 2 at the right atrium shows right atrial pressure here. A bracket between them is labelled coronary perfusion pressure, the difference between the two, measured at the same moment, between compressions. There is no direct connection from the aorta to the right atrium.';
const caption =
  'The coronary circuit. Blood enters the coronary arteries at the aortic root (①), crosses the heart muscle through progressively smaller vessels, and drains mostly through the coronary sinus into the right atrium (②). Coronary perfusion pressure is the difference between the pressures at ① and ②, read at the same moment in the release phase of compression. It is a pressure difference, not a pressure at any single point and not a measure of flow. Schematic, not to scale. In studies, these pressures are measured by catheters in or near these sites.';
---

<figure class="diagram" data-diagram="coronary-circuit">
  <svg class="diagram-stack" viewBox="0 0 340 1048" role="img" aria-labelledby={stackTitleId} aria-describedby={stackDescId}>
    <title id={stackTitleId}>{title}</title>
    <desc id={stackDescId}>{description}</desc>
    <defs>
      <pattern id="coronary-hatch-stack" width="7" height="7" patternUnits="userSpaceOnUse">
        <path class="diagram-hatch" d="M-1 6 L6 -1"></path>
      </pattern>
    </defs>

    <text class="diagram-marker-caption" x="170" y="26" text-anchor="middle" font-size="16">Aortic pressure</text>
    <text class="diagram-marker-caption" x="170" y="46" text-anchor="middle" font-size="16">during release</text>

    <path class="diagram-cpp" d="M18 78 H30 M18 78 V842 H30"></path>

    <path class="diagram-route" d="M128 64 H212"></path>
    <path class="diagram-route" d="M136 64 V166"></path>
    <path class="diagram-route" d="M204 64 V166"></path>
    <path class="diagram-route" d="M136 114 C114 122 114 158 136 170"></path>
    <path class="diagram-route" d="M204 114 C226 122 226 158 204 170"></path>
    <path class="diagram-route" d="M142 168 C150 154 158 154 166 168 C174 154 182 154 190 168 C198 154 206 154 214 168"></path>
    <circle class="diagram-opening" cx="204" cy="132" r="4.5"></circle>
    <circle class="diagram-opening" cx="204" cy="150" r="4.5"></circle>
    <path class="diagram-route" d="M208 132 H232 C248 132 248 150 264 150"></path>
    <path class="diagram-route" d="M208 150 H256"></path>
    <circle class="diagram-marker-ring" cx="170" cy="92" r="13"></circle>
    <text class="diagram-marker-num" x="170" y="92" font-size="16">1</text>

    <text class="diagram-label" x="170" y="200" text-anchor="middle" font-size="16">Aortic root</text>
    <text class="diagram-label" x="170" y="226" text-anchor="middle" font-size="16">coronary arteries begin here</text>
    <line class="diagram-route" x1="170" y1="240" x2="170" y2="262"></line>
    <polygon class="diagram-route-head" points="170,272 165,262 175,262"></polygon>

    <text class="diagram-label" x="170" y="300" text-anchor="middle" font-size="16">Epicardial arteries</text>
    <line class="diagram-route" x1="170" y1="312" x2="170" y2="338"></line>
    <polygon class="diagram-route-head" points="170,348 165,338 175,338"></polygon>

    <rect class="diagram-myocardium" x="50" y="364" width="240" height="168"></rect>
    <rect x="50" y="364" width="240" height="168" fill="url(#coronary-hatch-stack)"></rect>
    <path class="diagram-route" d="M170 348 V392"></path>
    <path class="diagram-route-fine" d="M170 392 C170 408 124 412 116 428"></path>
    <path class="diagram-route-fine" d="M170 392 V440"></path>
    <path class="diagram-route-fine" d="M170 392 C170 408 216 412 224 428"></path>
    <path class="diagram-route-fine" d="M116 428 C136 446 152 440 170 456"></path>
    <path class="diagram-route-fine" d="M170 440 V456"></path>
    <path class="diagram-route-fine" d="M224 428 C204 446 188 440 170 456"></path>
    <path class="diagram-route" d="M170 456 V532"></path>
    <path class="diagram-quiet" d="M224 428 C238 434 252 438 270 436"></path>

    <text class="diagram-label" x="170" y="554" text-anchor="middle" font-size="16">Arterioles and capillaries</text>
    <text class="diagram-label" x="170" y="574" text-anchor="middle" font-size="16">Heart muscle (myocardium)</text>
    <line class="diagram-route" x1="170" y1="586" x2="170" y2="608"></line>
    <polygon class="diagram-route-head" points="170,618 165,608 175,608"></polygon>
    <text class="diagram-label" x="170" y="644" text-anchor="middle" font-size="16">Cardiac veins</text>
    <line class="diagram-route" x1="170" y1="656" x2="170" y2="678"></line>
    <polygon class="diagram-route-head" points="170,688 165,678 175,678"></polygon>
    <text class="diagram-label" x="170" y="714" text-anchor="middle" font-size="16">Coronary sinus</text>
    <line class="diagram-route" x1="170" y1="726" x2="170" y2="748"></line>
    <polygon class="diagram-route-head" points="170,758 165,748 175,748"></polygon>

    <rect class="diagram-route" x="118" y="774" width="104" height="78" rx="22"></rect>
    <text class="diagram-label" x="170" y="804" text-anchor="middle" font-size="16">Right atrium</text>
    <circle class="diagram-marker-ring" cx="170" cy="834" r="13"></circle>
    <text class="diagram-marker-num" x="170" y="834" font-size="16">2</text>
    <text class="diagram-marker-caption" x="170" y="882" text-anchor="middle" font-size="16">Right atrial pressure</text>

    <text class="diagram-bracket-label" x="170" y="920" text-anchor="middle" font-size="16">difference between these two points</text>
    <text class="diagram-bracket-label" x="170" y="942" text-anchor="middle" font-size="16">= coronary perfusion pressure</text>

    <path class="diagram-quiet" d="M28 972 H56"></path>
    <text class="diagram-quiet-label" x="64" y="976" font-size="16">A smaller share drains by</text>
    <text class="diagram-quiet-label" x="64" y="996" font-size="16">small veins opening directly</text>
    <text class="diagram-quiet-label" x="64" y="1016" font-size="16">into heart chambers.</text>
  </svg>

  <svg class="diagram-wide" viewBox="0 0 640 420" role="img" aria-labelledby={wideTitleId} aria-describedby={wideDescId}>
    <title id={wideTitleId}>{title}</title>
    <desc id={wideDescId}>{description}</desc>
    <defs>
      <pattern id="coronary-hatch-wide" width="7" height="7" patternUnits="userSpaceOnUse">
        <path class="diagram-hatch" d="M-1 6 L6 -1"></path>
      </pattern>
    </defs>

    <text class="diagram-marker-caption" x="20" y="26" font-size="17">Aortic pressure</text>
    <text class="diagram-marker-caption" x="20" y="46" font-size="17">during release</text>
    <text class="diagram-marker-caption" x="620" y="38" text-anchor="end" font-size="17">Right atrial pressure</text>

    <path class="diagram-route" d="M44 70 H112"></path>
    <path class="diagram-route" d="M52 70 V158"></path>
    <path class="diagram-route" d="M104 70 V158"></path>
    <path class="diagram-route" d="M52 112 C32 120 32 152 52 164"></path>
    <path class="diagram-route" d="M104 112 C124 120 124 152 104 164"></path>
    <path class="diagram-route" d="M58 160 C64 148 70 148 76 160 C82 148 88 148 94 160 C98 150 102 150 106 160"></path>
    <circle class="diagram-opening" cx="104" cy="128" r="4.5"></circle>
    <circle class="diagram-opening" cx="104" cy="146" r="4.5"></circle>
    <path class="diagram-route" d="M108 128 H140 C160 128 160 146 180 146"></path>
    <path class="diagram-route" d="M108 146 H172"></path>
    <path class="diagram-route" d="M180 146 H252"></path>
    <polygon class="diagram-route-head" points="262,146 252,141 252,151"></polygon>
    <circle class="diagram-marker-ring" cx="78" cy="96" r="13"></circle>
    <text class="diagram-marker-num" x="78" y="96" font-size="16">1</text>

    <text class="diagram-label" x="78" y="196" text-anchor="middle" font-size="16">Aortic root</text>
    <text class="diagram-label" x="148" y="176" font-size="16">coronary arteries</text>
    <text class="diagram-label" x="148" y="196" font-size="16">begin here</text>
    <text class="diagram-label" x="200" y="124" text-anchor="middle" font-size="16">Epicardial arteries</text>

    <rect class="diagram-myocardium" x="272" y="76" width="156" height="150"></rect>
    <rect x="272" y="76" width="156" height="150" fill="url(#coronary-hatch-wide)"></rect>
    <rect class="diagram-label-plate" x="280" y="84" width="140" height="36"></rect>
    <text class="diagram-label" x="350" y="100" text-anchor="middle" font-size="15">Arterioles and</text>
    <text class="diagram-label" x="350" y="116" text-anchor="middle" font-size="15">capillaries</text>
    <path class="diagram-route" d="M262 146 H304"></path>
    <path class="diagram-route-fine" d="M304 146 C314 146 318 108 332 104"></path>
    <path class="diagram-route-fine" d="M304 146 H346"></path>
    <path class="diagram-route-fine" d="M304 146 C314 146 318 184 332 190"></path>
    <path class="diagram-route-fine" d="M332 104 C350 110 360 134 378 146"></path>
    <path class="diagram-route-fine" d="M346 146 H378"></path>
    <path class="diagram-route-fine" d="M332 190 C350 180 364 158 378 152"></path>
    <path class="diagram-route" d="M378 146 H428"></path>
    <polygon class="diagram-route-head" points="438,146 428,141 428,151"></polygon>
    <path class="diagram-quiet" d="M400 176 C408 200 416 214 416 236"></path>
    <text class="diagram-label" x="280" y="214" font-size="15">Heart muscle</text>
    <text class="diagram-label" x="280" y="230" font-size="15">(myocardium)</text>

    <text class="diagram-label" x="492" y="118" text-anchor="middle" font-size="16">Cardiac veins</text>
    <path class="diagram-route" d="M438 146 H508"></path>
    <text class="diagram-label" x="530" y="178" text-anchor="middle" font-size="16">Coronary sinus</text>
    <path class="diagram-route" d="M508 146 H556"></path>
    <polygon class="diagram-route-head" points="566,146 556,141 556,151"></polygon>

    <rect class="diagram-route" x="572" y="104" width="52" height="84" rx="16"></rect>
    <text class="diagram-label" x="624" y="212" text-anchor="end" font-size="16">Right atrium</text>
    <circle class="diagram-marker-ring" cx="598" cy="146" r="13"></circle>
    <text class="diagram-marker-num" x="598" y="146" font-size="16">2</text>

    <text class="diagram-quiet-label" x="20" y="268" font-size="16">A smaller share drains by small veins</text>
    <text class="diagram-quiet-label" x="20" y="288" font-size="16">opening directly into heart chambers.</text>

    <path class="diagram-cpp" d="M78 320 V340 H598 V320"></path>
    <text class="diagram-bracket-label" x="338" y="372" text-anchor="middle" font-size="16">difference between these two points</text>
    <text class="diagram-bracket-label" x="338" y="394" text-anchor="middle" font-size="16">= coronary perfusion pressure</text>
  </svg>

  <figcaption>
    <p class="kicker">Figure</p>
    <p>{caption}</p>
  </figcaption>
</figure>
