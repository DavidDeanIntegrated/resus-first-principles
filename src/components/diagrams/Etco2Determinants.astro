---
import { etco2Caption, etco2Desc, etco2Title } from '../../lib/figure-copy.ts';

const titleId = 'diagram-etco2-determinants-title';
const descId = 'diagram-etco2-determinants-desc';
---

<figure class="diagram" data-diagram="etco2-determinants">
  <svg viewBox="0 0 320 600" role="img" aria-labelledby={titleId} aria-describedby={descId}>
    <title id={titleId}>{etco2Title}</title>
    <desc id={descId}>{etco2Desc}</desc>

    <rect class="diagram-banner" x="0" y="0" width="320" height="48"></rect>
    <rect class="diagram-mark" x="0" y="0" width="4" height="48"></rect>
    <text class="diagram-schematic" x="16" y="30" font-size="15">Schematic, not measured data</text>

    <text class="diagram-caps" x="16" y="78" font-size="14">Reading</text>
    <text class="diagram-display" x="16" y="112" font-size="18">End-tidal CO2</text>
    <text class="diagram-note" x="16" y="144" font-size="15">Reflects these.</text>

    <rect class="diagram-panel-flow" x="16" y="168" width="252" height="168"></rect>
    <text class="diagram-label" x="32" y="212" font-size="15">CO2 production</text>
    <text class="diagram-label" x="32" y="260" font-size="15">Pulmonary blood flow</text>
    <text class="diagram-label" x="32" y="308" font-size="15">Ventilation</text>
    <path class="diagram-bracket" d="M276 168 H292 M284 168 V336 M276 336 H292"></path>

    <rect class="diagram-mark" x="16" y="368" width="48" height="2"></rect>

    <text class="diagram-caps" x="16" y="408" font-size="14">Other than flow</text>
    <rect class="diagram-aside" x="16" y="428" width="288" height="132"></rect>
    <text class="diagram-note" x="32" y="468" font-size="15">Drugs such as epinephrine</text>
    <text class="diagram-note" x="32" y="496" font-size="15">can shift the reading</text>
    <text class="diagram-note" x="32" y="524" font-size="15">for reasons other than flow.</text>
  </svg>
  <figcaption>
    <p class="kicker">Figure</p>
    <p>{etco2Caption}</p>
  </figcaption>
</figure>
