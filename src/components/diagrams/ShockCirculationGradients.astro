---
// S5 (Atelier): drawn figure; replaces the S6 placeholder. Caption comes from the module (prop);
// title and desc are copied verbatim from s4/manuscript.md (sha 6c0f5c0a). Schematic; tokens only.
interface Props {
  caption: string;
  alt: string;
}

const { caption } = Astro.props;
const title = "One circulation, several pressure gradients.";
const desc = "Schematic loop with two hearts drawn as separate pumps. Arrows run in one direction: left ventricle to aorta and systemic arteries, through a narrowed resistance segment and a capillary bed, into wide veins, to the right atrium, right ventricle, pulmonary arteries, lung capillaries, pulmonary veins, left atrium, and back to the left ventricle. Labels mark the systemic gradient from aorta to right atrium and the pulmonary gradient from pulmonary artery to left atrium, and a note states that right atrial pressure and pulmonary venous pressure are different locations.";
