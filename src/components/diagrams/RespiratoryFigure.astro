---
// Same wrapper as the Shock figures: a screen SVG, a print SVG, and a figcaption
// whose caption comes from the chapter module. Title and description stay in the SVG.
import { respiratorySvg, type RespiratoryFigureId } from '../../lib/respiratory-figures.ts';

interface Props {
  id: RespiratoryFigureId;
  caption: string;
  alt: string;
}

const { id, caption } = Astro.props;
const screen = respiratorySvg(id, 'screen');
const print = respiratorySvg(id, 'print');
---

<figure class="diagram" data-diagram={id}>
  <Fragment set:html={screen} />
  <Fragment set:html={print} />
  <figcaption>
    <p class="kicker">Figure</p>
    <p>{caption}</p>
  </figcaption>
</figure>
