---
const wideTitleId = 'diagram-compression-release-wide-title';
const wideDescId = 'diagram-compression-release-wide-desc';
const stackTitleId = 'diagram-compression-release-stack-title';
const stackDescId = 'diagram-compression-release-stack-desc';

const title = 'Read during release';
const description =
  'Three cells, not a measured waveform. Compression: the vessels in the heart muscle are narrowed but a lumen remains, and forward coronary flow is small. Release: the coronary bed fills mainly now, inside a window marked read here, where relaxation-phase aortic pressure and right atrial pressure are taken at the same moment. Pause: no compression, aortic pressure decays. The pause is set apart from the cycle.';
const caption =
  'Read during release. During compression, forward coronary flow is small and the vessels in the heart muscle are narrowed but not shut. On release, the coronary bed fills mainly now. The sage window is where relaxation-phase aortic pressure and right atrial pressure are read at the same moment. A pause is not that release. Pause: no compression, aortic pressure decays. Schematic, not a measured waveform and not to scale in time.';
---

<figure class="diagram" data-diagram="compression-release">
  <svg class="diagram-stack" viewBox="0 0 340 950" role="img" aria-labelledby={stackTitleId} aria-describedby={stackDescId}>
    <title id={stackTitleId}>{title}</title>
    <desc id={stackDescId}>{description}</desc>
    <defs>
      <pattern id="compression-release-hatch-stack" width="7" height="7" patternUnits="userSpaceOnUse">
        <path class="diagram-hatch" d="M-1 6 L6 -1"></path>
      </pattern>
    </defs>

    <text class="diagram-panel-title" x="8" y="30" font-size="20">Read during release</text>
    <text class="diagram-key" x="8" y="56" font-size="15">One cycle, not a measured waveform</text>

    <rect class="diagram-cell-rule" x="8" y="76" width="324" height="250" rx="6"></rect>
    <text class="diagram-key" x="24" y="104" font-size="16">Compression</text>
    <rect class="diagram-myocardium" x="24" y="120" width="200" height="112"></rect>
    <rect x="24" y="120" width="200" height="112" fill="url(#compression-release-hatch-stack)"></rect>
    <g class="diagram-vessel-narrow">
      <path d="M44 142 C96 138 150 146 196 142"></path>
      <path d="M44 151 C96 147 150 155 196 151"></path>
      <path d="M48 176 C100 180 148 172 192 176"></path>
      <path d="M48 185 C100 189 148 181 192 185"></path>
      <path d="M52 210 C100 206 150 214 188 210"></path>
      <path d="M52 219 C100 215 150 223 188 219"></path>
    </g>
    <text class="diagram-label" x="24" y="268" font-size="16">forward coronary flow</text>
    <text class="diagram-label" x="24" y="290" font-size="16">is small</text>

    <rect class="diagram-read-window" x="8" y="342" width="324" height="280" rx="6"></rect>
    <text class="diagram-key" x="24" y="370" font-size="16">Release</text>
    <text class="diagram-marker-caption" x="24" y="394" font-size="16">Read here</text>
    <rect class="diagram-myocardium" x="24" y="414" width="200" height="112"></rect>
    <rect x="24" y="414" width="200" height="112" fill="url(#compression-release-hatch-stack)"></rect>
    <g class="diagram-vessel-open">
      <path d="M40 428 C90 428 130 436 200 430"></path>
      <path d="M40 446 C90 446 130 454 200 448"></path>
      <path d="M40 464 C100 468 140 458 200 466"></path>
      <path d="M40 482 C100 486 140 476 200 484"></path>
      <path d="M40 498 C80 498 140 490 190 502"></path>
      <path d="M40 516 C80 516 140 508 190 520"></path>
    </g>
    <text class="diagram-label" x="24" y="562" font-size="16">the coronary bed fills</text>
    <text class="diagram-label" x="24" y="584" font-size="16">mainly now</text>

    <rect class="diagram-cell-rule" x="8" y="658" width="324" height="260" rx="6"></rect>
    <text class="diagram-key" x="24" y="686" font-size="16">Pause</text>
    <path class="diagram-quiet" d="M48 718 C110 730 150 790 250 830"></path>
    <text class="diagram-label" x="24" y="858" font-size="16">Pause: no compression,</text>
    <text class="diagram-label" x="24" y="880" font-size="16">aortic pressure decays</text>
  </svg>

  <svg class="diagram-wide" viewBox="0 0 640 388" role="img" aria-labelledby={wideTitleId} aria-describedby={wideDescId}>
    <title id={wideTitleId}>{title}</title>
    <desc id={wideDescId}>{description}</desc>
    <defs>
      <pattern id="compression-release-hatch-wide" width="7" height="7" patternUnits="userSpaceOnUse">
        <path class="diagram-hatch" d="M-1 6 L6 -1"></path>
      </pattern>
    </defs>

    <text class="diagram-panel-title" x="20" y="34" font-size="22">Read during release</text>
    <text class="diagram-key" x="20" y="60" font-size="16">One cycle, not a measured waveform</text>

    <rect class="diagram-cell-rule" x="16" y="80" width="188" height="292" rx="6"></rect>
    <text class="diagram-key" x="28" y="108" font-size="16">Compression</text>
    <rect class="diagram-myocardium" x="36" y="124" width="148" height="108"></rect>
    <rect x="36" y="124" width="148" height="108" fill="url(#compression-release-hatch-wide)"></rect>
    <g class="diagram-vessel-narrow">
      <path d="M50 146 C88 142 130 150 170 146"></path>
      <path d="M50 154 C88 150 130 158 170 154"></path>
      <path d="M50 178 C92 182 132 174 170 178"></path>
      <path d="M50 186 C92 190 132 182 170 186"></path>
      <path d="M54 210 C90 206 136 214 166 210"></path>
      <path d="M54 218 C90 214 136 222 166 218"></path>
    </g>
    <text class="diagram-label" x="28" y="268" font-size="16">forward coronary flow</text>
    <text class="diagram-label" x="28" y="290" font-size="16">is small</text>

    <rect class="diagram-read-window" x="220" y="80" width="200" height="292" rx="6"></rect>
    <text class="diagram-key" x="232" y="108" font-size="16">Release</text>
    <text class="diagram-marker-caption" x="232" y="132" font-size="16">Read here</text>
    <rect class="diagram-myocardium" x="240" y="148" width="160" height="96"></rect>
    <rect x="240" y="148" width="160" height="96" fill="url(#compression-release-hatch-wide)"></rect>
    <g class="diagram-vessel-open">
      <path d="M256 162 C300 162 340 168 384 164"></path>
      <path d="M256 178 C300 178 340 184 384 180"></path>
      <path d="M256 192 C310 196 350 186 384 194"></path>
      <path d="M256 208 C310 212 350 202 384 210"></path>
      <path d="M256 220 C290 220 350 212 376 226"></path>
      <path d="M256 236 C290 236 350 228 376 242"></path>
    </g>
    <text class="diagram-label" x="232" y="276" font-size="16">the coronary bed fills</text>
    <text class="diagram-label" x="232" y="298" font-size="16">mainly now</text>

    <rect class="diagram-cell-rule" x="456" y="80" width="168" height="292" rx="6"></rect>
    <text class="diagram-key" x="468" y="108" font-size="16">Pause</text>
    <path class="diagram-quiet" d="M484 150 C520 170 540 230 590 280"></path>
    <text class="diagram-label" x="468" y="318" font-size="15">Pause: no compression,</text>
    <text class="diagram-label" x="468" y="338" font-size="15">aortic pressure decays</text>
  </svg>

  <figcaption>
    <p class="kicker">Figure</p>
    <p>{caption}</p>
  </figcaption>

  <details class="diagram-data">
    <summary>Data as table</summary>
    <table>
      <caption>One cycle, read during release. Not a measured waveform.</caption>
      <thead>
        <tr>
          <th scope="col">Phase</th>
          <th scope="col">What the drawing shows</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Compression</th>
          <td>Vessels in the heart muscle are narrowed, with a lumen still open. Forward coronary flow is small.</td>
        </tr>
        <tr>
          <th scope="row">Release</th>
          <td>The coronary bed fills mainly now. Read here: relaxation-phase aortic pressure and right atrial pressure, at the same moment.</td>
        </tr>
        <tr>
          <th scope="row">Pause</th>
          <td>Pause: no compression, aortic pressure decays.</td>
        </tr>
      </tbody>
    </table>
    <p>Coronary perfusion pressure is read during the release phase of each compression, with both pressures taken at the same moment.</p>
  </details>
</figure>
