---
import { cycleArithmeticCaption } from '../lib/section-layout.ts';
---

<figure class="cycle-arithmetic">
  <table>
    <caption>{cycleArithmeticCaption}</caption>
    <thead>
      <tr>
        <th scope="col">Rate</th>
        <th scope="col">Cycle</th>
        <th scope="col">Release</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">100/min</th>
        <td>0.6 s</td>
        <td>about 0.3 s</td>
      </tr>
      <tr>
        <th scope="row">120/min</th>
        <td>0.5 s</td>
        <td>about 0.25 s</td>
      </tr>
    </tbody>
  </table>
</figure>
