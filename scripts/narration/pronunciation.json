{
  "$comment": "Reusable medical pronunciation rules for hosted narration. Applied in order, as Python regular expressions, to the synthesis text only; the verbatim chapter text is never changed. A rule may change how a symbol, unit or abbreviation is spoken, never what the sentence says. 'unhandled' lists characters that must not reach the synthesizer.",
  "rules": [
    { "match": "\\blog\\((\\d+) / \\(([\\d.]+) × ([\\d.]+)\\)\\)", "say": "log of \\1 divided by the product of \\2 and \\3" },
    { "match": "\\bmL/cm H2O\\b", "say": "milliliters per centimeter of water" },
    { "match": "\\bcm H2O/L/s\\b", "say": "centimeters of water per liter per second" },
    { "match": "\\bdyn·s·cm-5\\b", "say": "dyne seconds per centimeter to the fifth" },
    { "match": "\\bmmHg\\b", "say": "millimeters of mercury" },
    { "match": "\\bmg/dL\\b", "say": "milligrams per deciliter" },
    { "match": "\\bg/dL\\b", "say": "grams per deciliter" },
    { "match": "\\bmL/dL\\b", "say": "milliliters per deciliter" },
    { "match": "\\bdL/min\\b", "say": "deciliters per minute" },
    { "match": "\\bmL/kg\\b", "say": "milliliters per kilogram" },
    { "match": "(?<=\\d) L/s\\b", "say": " liters per second" },
    { "match": "\\bbreaths/min\\b", "say": "breaths per minute" },
    { "match": "(?<=\\d)/min\\b", "say": " per minute" },
    { "match": "\\bPaO2/FiO2\\b", "say": "P A O two over F I O two" },
    { "match": "\\bSpO2/FiO2\\b", "say": "S P O two over F I O two" },
    { "match": "\\bPaCO2/R\\b", "say": "P A C O two divided by R" },
    { "match": "\\bVD/VT\\b", "say": "V D over V T" },
    { "match": "\\bV/Q\\b", "say": "V over Q" },
    { "match": "\\bage/4\\b", "say": "age divided by 4" },
    { "match": "\\bACC/AHA\\b", "say": "A C C A H A" },
    { "match": "\\bERS/ATS\\b", "say": "E R S A T S" },
    { "match": ">(?=\\d)", "say": "greater than " },
    { "match": "<(?=\\d)", "say": "less than " },
    { "match": "(?<=[\\d)]) x (?=[\\d(])", "say": " times " },
    { "match": " − ", "say": " minus " },
    { "match": "(?<=[\\d)]) - (?=[\\d(])", "say": " minus " },

    { "match": " ≈ ", "say": ", about " },
    { "match": " × ", "say": " times " },
    { "match": " / ", "say": " divided by " },
    { "match": " = ", "say": " equals " },
    { "match": " \\+ ", "say": " plus " },
    { "match": "(?<=\\d) vs\\.? (?=\\d)", "say": " versus " },
    { "match": "\\b(\\d{2,3})/(\\d{2,3})\\b", "say": "\\1 over \\2" },
    { "match": "(?<=[\\d)])/(?=\\d)", "say": " divided by " },
    { "match": "–", "say": "-" },

    { "match": "\\bmm Hg\\b", "say": "millimeters of mercury" },
    { "match": "\\bcm H2O\\b", "say": "centimeters of water" },
    { "match": "\\bmmol/L\\b", "say": "millimoles per liter" },
    { "match": "\\bmL/min\\b", "say": "milliliters per minute" },
    { "match": "\\bL/min\\b", "say": "liters per minute" },
    { "match": "(?<=\\d) mL\\b", "say": " milliliters" },
    { "match": "(?<=\\d) L\\b", "say": " liters" },
    { "match": "(?<=\\d) kg\\b", "say": " kilograms" },

    { "match": "\\bFiO2\\b", "say": "F I O two" },
    { "match": "\\bPIO2\\b", "say": "P I O two" },
    { "match": "\\bVCO2\\b", "say": "V C O two" },
    { "match": "\\bPvCO2\\b", "say": "P V C O two" },
    { "match": "\\bCaO2\\b", "say": "C A O two" },
    { "match": "\\bCvO2\\b", "say": "C V O two" },
    { "match": "\\bScvO2\\b", "say": "S C V O two" },
    { "match": "\\bPO2\\b", "say": "P O two" },
    { "match": "\\bDO2\\b", "say": "D O two" },
    { "match": "\\bVO2\\b", "say": "V O two" },
    { "match": "\\bPH2O\\b", "say": "P H two O" },
    { "match": "\\bPDE5\\b", "say": "P D E five" },
    { "match": "\\bPaCO2\\b", "say": "P A C O two" },
    { "match": "\\bPaO2\\b", "say": "P A O two" },
    { "match": "\\bPAO2\\b", "say": "P A O two" },
    { "match": "\\bSpO2\\b", "say": "S P O two" },
    { "match": "\\bSaO2\\b", "say": "S A O two" },
    { "match": "\\bCO2\\b", "say": "C O two" },
    { "match": "\\bpH\\b", "say": "P H" },
    { "match": "\\bFRC\\b", "say": "F R C" },
    { "match": "\\bRV\\b", "say": "R V" },
    { "match": "\\bICU\\b", "say": "I C U" },
    { "match": "\\bUK\\b", "say": "U K" },
    { "match": "\\bPEEP\\b", "say": "peep" },

    { "match": "\\bPREOXI\\b", "say": "Pre-Oxy" },
    { "match": "\\bPreVent\\b", "say": "Pre-Vent" },
    { "match": "\\bPREPARE II\\b", "say": "Prepare Two" },
    { "match": "\\bINTUBE\\b", "say": "In-Tube" },
    { "match": "\\bTHRIVE\\b", "say": "Thrive" },
    { "match": "\\bFELLOW\\b", "say": "Fellow" },

    { "match": "\\bParts II to IV\\b", "say": "Parts Two to Four" },
    { "match": "\\bParts II to VI\\b", "say": "Parts Two to Six" },
    { "match": "\\bParts VI and VII\\b", "say": "Parts Six and Seven" },
    { "match": "\\b([Aa])ngiotensin II\\b", "say": "\\1ngiotensin two" },
    { "match": "\\bPart IX\\b", "say": "Part Nine" },
    { "match": "\\bPart VIII\\b", "say": "Part Eight" },
    { "match": "\\bPart VII\\b", "say": "Part Seven" },
    { "match": "\\bPart VI\\b", "say": "Part Six" },
    { "match": "\\bPart IV\\b", "say": "Part Four" },
    { "match": "\\bPart V\\b", "say": "Part Five" },
    { "match": "\\bPart III\\b", "say": "Part Three" },
    { "match": "\\bPart II\\b", "say": "Part Two" },
    { "match": "\\bPart I\\b", "say": "Part One" }
  ],
  "unhandled": "[×÷≈=+/–—<>≤≥±°·²⁻⁵π*\\[\\]]|\\b[A-Za-z]+[0-9]\\b|\\b(?:II|III|IV|VI|VII|VIII|IX)\\b"
}
