{
  "name": "resus-first-principles",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run validate",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "node --experimental-strip-types scripts/validate-content.ts",
    "validate:strict": "node --experimental-strip-types scripts/validate-content.ts --strict",
    "check:no-models": "node scripts/check-no-model-calls.mjs",
    "check:types": "astro check",
    "check:worker": "wrangler types && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "astro": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.152.0"
  }
}
